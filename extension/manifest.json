{
  "manifest_version": 3,
  "name": "Voitta",
  "description": "Opens the Voitta assistant on pages whose Content-Security-Policy blocks the bookmarklet.",
  "version": "0.3.0",
  "key": "",
  "minimum_chrome_version": "135",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "userScripts"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://localhost/*",
    "https://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Voitta on this page",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "src/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/report-frame.html",
        "src/report-frame.js",
        "src/config.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
