# Server .env for deploy/compose.yml — copy to the checkout root as .env, chmod 600.

# Google sign-in (OAuth web client). Setting both turns on accounts + sign-in.
# Authorized redirect URI: ${VOITTA_PUBLIC_BASE_URL}/api/auth/google/callback
VOITTA_GOOGLE_AUTH_CLIENT_ID=
VOITTA_GOOGLE_AUTH_CLIENT_SECRET=

# The public https address (bookmarklet links, OAuth redirect, "our own pages").
VOITTA_PUBLIC_BASE_URL=https://bookmarklet.voitta.ai

# Always-admin accounts (comma-separated). Can't be demoted or disabled;
# created on first Google sign-in if not invited.
VOITTA_OWNERS=roman.semein@gmail.com

# Optional: pin the session-signing secret (default: generated once into data/auth_secret).
# VOITTA_AUTH_SECRET=
