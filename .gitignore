# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Operator secrets (server deployments). Committed template: .env.example
.env

# mkcert TLS pair, minted per machine (README setup, or the tray's
# "(Re)create TLS certificates…"). A committed key is public and only
# verifies on the machine whose local CA signed it.
backend/certs/

# Node / Vite
node_modules/
frontend/dist/

# Built RAG indexes (rebuildable via `python scripts/build_rag.py`).
# Leading slash anchors to the repo root — without it, `rag/` also
# matches backend/app/tools/rag/ and silently drops the runtime
# package from git.
/rag/

# Third-party docs a plugin declares via manifest `docs_repo`. Fetched and
# converted at install time (see installer.sync_plugin_docs), so both trees
# are rebuildable and neither belongs in git.
/plugin-docs/
/plugin-docs-src/

# Chainlit session/translations cache
.chainlit/
.files/

# python_storage (runtime artefact cache, populated by report scripts)
python_storage/

# Script state (per-run render events; not source)
scripts_state/

# Build-generated resource staging (populated by build_app.sh step 5).
# Master copies live in docs/, plugins/, frontend/ — never edit under resources/.
src/voitta_bookmarklet/resources/docs/
src/voitta_bookmarklet/resources/frontend_dist/
src/voitta_bookmarklet/resources/plugins/
src/voitta_bookmarklet/resources/vendor_js/

# Build artifacts / release binaries
dist/
wheels/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code local state (scheduled task lock, etc).
.claude/
build/

# Standalone voice prototype (1.3 GB: .venv + onnx models + wav). The
# shipping voice code is backend/app/services/voice*.py, ported from here.
audio/

# Stray / generated, not part of the package or build.
src/voitta/
scripts/reports/

# Runtime logs written next to the app at launch.
voitta.log
frontend/voitta.log

# Briefcase build logs (create/update/package) — regenerated every build.
logs/
